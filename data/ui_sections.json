        { "render": "table", "source": "sources", "sort": "last_synced", "order": "desc", "columns": [
          { "key": "name", "label": "Source", "fmt": "text", "strong": true },
          { "key": "method", "label": "Méthode", "fmt": "pill" },
          { "key": "collector", "label": "Collecteur", "fmt": "mono" },
          { "key": "auto", "label": "Auto", "fmt": "bool" },
          { "key": "cadence_days", "label": "Cadence", "fmt": "num", "suffix": " j" },
          { "key": "last_synced", "label": "Dernière synchro", "fmt": "ago", "staleFrom": "cadence_days" },
          { "key": "status", "label": "État", "fmt": "badge" }
        ] }
      ]
    },
