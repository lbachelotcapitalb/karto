          { "key": "kind", "label": "Nature", "fmt": "pill" },
          { "key": "outils", "label": "Outils visés", "fmt": "list" },
          { "key": "preconditions", "label": "Préconditions", "fmt": "list" },
          { "key": "effet", "label": "Effet", "fmt": "text" },
          { "key": "agents_autorises", "label": "Agents autorisés", "fmt": "list" }
